FPL_ENTRY_ID=354978
FPL_BASE_URL=https://fantasy.premierleague.com/api
FPL_USER_AGENT=Tashi-FPL-MCP/1.0
# Refresh token from your authenticated FPL browser session. Keep this secret out of Git.
# Used only to seed the token database on first start; FPL rotates it, and the
# latest token then lives in FPL_TOKEN_DB. To re-login later, run fpl-mcp-set-token.
FPL_REFRESH_TOKEN=
FPL_TOKEN_URL=https://account.premierleague.com/as/token
FPL_CLIENT_ID=bfcbaf69-aade-4c1b-8f00-c1cb8a193030
REQUEST_TIMEOUT_SECONDS=15
MAX_LEAGUE_PAGES=5
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Add your public domain (exact hostname, no https://) before connecting ChatGPT.
MCP_ALLOWED_HOSTS=["localhost","localhost:*","127.0.0.1","127.0.0.1:*","fpl-ai.example.com"]
MCP_ALLOWED_ORIGINS=["http://localhost:*","http://127.0.0.1:*"]

# Login alerts and advisor messages (Telegram). Create a bot with @BotFather.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# FPL_TOKEN_KEEPALIVE_HOURS=6

# Proactive advisor: squad watch + pre-deadline briefings.
ADVISOR_ENABLED=false
# Paid and optional. Leave empty to never use the Anthropic API.
ANTHROPIC_API_KEY=
# ADVISOR_MODEL=claude-sonnet-5-5
# ADVISOR_MCP_URL=https://fpl.dcpl.bt/mcp
# ADVISOR_INTERVAL_MINUTES=30
# ADVISOR_PREVIEW_HOURS=24
# ADVISOR_FINAL_HOURS=3

# Free briefings from your own LLM (OpenAI-compatible, e.g. llama.cpp llama-server).
# Takes priority over ANTHROPIC_API_KEY; leave both empty for rule-based checks only.
LLM_BASE_URL=
# LLM_MODEL=local
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=600
